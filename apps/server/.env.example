NODE_ENV=development
PORT=3101
# Production host-network containers must bind only to loopback behind Nginx.
BIND_HOST=0.0.0.0
ADMIN_ORIGIN=http://localhost:3200
CLIENT_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_studio
DB_USER=ai_studio
DB_PASSWORD=replace-with-runtime-secret
DB_CONNECTION_LIMIT=10

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
CREDENTIAL_ENCRYPTION_KEY=replace-with-an-independent-32-character-secret

# Configure HTTP API or SMTP host/port/TLS and sender/password in Admin > Settings > Email Configuration.
# They are read from MySQL, not environment variables. Only timeout remains here.
# HTTP overall timeout; SMTP DNS/connection/greeting/socket idle timeout per phase.
MAIL_API_TIMEOUT_MS=30000
# Optional trusted reverse-proxy IPs/CIDRs. Keep empty for direct access.
# Example for a local Nginx proxy: TRUST_PROXY=loopback
TRUST_PROXY=

# Only used by `npm run db:bootstrap-admin`.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-temporary-password
BOOTSTRAP_ADMIN_NAME=系统管理员
