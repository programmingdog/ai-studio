{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Video Studio",
  "version": "0.1.0",
  "identifier": "studio.aivideo.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:media && npm run prepare:worker && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:media && npm run prepare:worker && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Video Studio",
        "theme": "Light",
        "backgroundColor": "#f5f6fa",
        "width": 1440,
        "height": 900,
        "maximized": true,
        "minWidth": 1080,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "THIRD_PARTY_NOTICES.md",
      "binaries/FFMPEG_LICENSE.txt",
      "binaries/FFMPEG_BUILD_README.txt"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/yt-dlp",
      "binaries/aivs-worker"
    ]
  }
}
