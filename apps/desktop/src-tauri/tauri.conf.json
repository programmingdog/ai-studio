{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "逐梦帧",
  "mainBinaryName": "逐梦帧",
  "version": "0.1.0",
  "identifier": "studio.aivideo.desktop",
  "build": {
    "beforeDevCommand": "npm run prepare:media && npm run prepare:worker && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:media && npm run prepare:worker && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "逐梦帧",
        "theme": "Light",
        "backgroundColor": "#f5f6fa",
        "width": 560,
        "height": 720,
        "center": true,
        "maximized": false,
        "resizable": false,
        "minWidth": 520,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "THIRD_PARTY_NOTICES.md",
      "binaries/FFMPEG_LICENSE.txt",
      "binaries/FFMPEG_BUILD_README.txt"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/yt-dlp",
      "binaries/aivs-worker"
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCRjlEMzRBNUYxRTU4MzkKUldRNVdCNWZTdFA1dTV0WnZ4Rnc0K1BpMkNiMExtcEMwU3VDZk9Pd05IeFM3ZVZKKzJuSVhFcGsK",
      "endpoints": [
        "https://ai-studio.yuntianxing.net/api/v1/client-config/desktop-updates/{{target}}/{{arch}}/{{current_version}}?channel=stable"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
