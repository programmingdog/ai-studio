# Copy to /opt/aivs/shared/api.env, mode 600. Compose >=2.30 uses format: raw.
# Values are literal: do not quote passwords and do not source this file in Bash.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_studio
DB_USER=ai_studio
DB_PASSWORD=REPLACE_ME
DB_CONNECTION_LIMIT=10
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=8h
# If moving an existing DB, preserve the EXACT existing encryption key.
CREDENTIAL_ENCRYPTION_KEY=REPLACE_OR_COPY_EXISTING_ENCRYPTION_KEY
ADMIN_ORIGIN=https://ai-studio.yuntianxing.net
CLIENT_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,tauri://localhost,http://tauri.localhost,https://tauri.localhost
MAIL_API_TIMEOUT_MS=30000
