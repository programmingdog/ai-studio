# Add these directives INSIDE the existing Baota HTTPS server {} for
# ai-studio.yuntianxing.net. Keep Baota's certificate/ACME directives.
# Remove conflicting location / or static-extension regex cache rules first.
client_max_body_size 120m;

# Avoid publishing DB-version diagnostics / interactive API docs by default.
location = /api/v1/health { return 404; }
location = /api-docs { return 404; }
location ^~ /api-docs/ { return 404; }

# No trailing slash on proxy_pass: preserve /api/v1 in the upstream URL.
location ^~ /api/v1/ {
    proxy_pass http://127.0.0.1:3101;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    # Overwrite, do not trust a client-supplied X-Forwarded-For chain.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_connect_timeout 10s;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_buffering off;
}

# Versioned Windows installers and signed updater artifacts. On the server,
# store them under /var/www/aivs-public/client/{version}/. Keep each published
# URL immutable; publish a higher version instead of replacing an old file.
location ^~ /client/ {
    root /var/www/aivs-public;
    autoindex off;
    try_files $uri =404;

    types {
        application/vnd.microsoft.portable-executable exe;
        application/zip zip;
        text/plain sig;
    }
    default_type application/octet-stream;

    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
}

location / {
    proxy_pass http://127.0.0.1:3200;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
    proxy_read_timeout 60s;
    proxy_buffering off;
}
